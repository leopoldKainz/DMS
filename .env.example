# Docker Compose configuration
COMPOSE_FILE=local-compose.yml

# Database configuration
POSTGRES_DB=dms
POSTGRES_USER=dms
POSTGRES_PASSWORD=dms_password

# Application runtime environment
ASPNETCORE_ENVIRONMENT=Development
Jwt__Key=temp_secret_keytemp_secret_keytemp_secret_key
ConnectionStrings__DefaultConnection=Host=db;Port=5432;Database=dms;Username=dms;Password=dms_password

# RabbitMQ configuration
RABBITMQ_DEFAULT_USER=rabbitmq
RABBITMQ_DEFAULT_PASS=rabbitmq_password
ConnectionStrings__RabbitMq=amqp://rabbitmq:rabbitmq_password@rabbitmq:5672

#RustFS configuration
RUSTFS_ACCESS_KEY=<user>
RUSTFS_SECRET_KEY=<password, at least 8 characters>
RustFS__AccessKey=<exactly the same as RUSTFS_ACCESS_KEY>
RustFS__SecretKey=<exactly the same as RUSTFS_SECRET_KEY>